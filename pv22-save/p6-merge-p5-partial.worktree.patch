 +    if (b.hi - ls.t[u] >= 0.22 && x - tl.xOf(l.t0) > 12 && tl.xOf(l.t1) - x > 12 && x > 10 && x < r.width - 60) {
 +      return { u, x: r.left + x, y: r.top + rows.line[1] - 6, t: ls.t[u], px: tl.xOf(ls.t[u] + 1) - x, n: ls.t.length };
