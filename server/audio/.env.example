# Generate a long random value. Never commit the actual token.
AUDIO_SERVER_TOKEN=replace-with-a-long-random-secret
AUDIO_ALLOWED_ORIGINS=https://momomonbi.github.io
# Conservative defaults for the supplied 2 GB Docker Compose container.
AUDIO_MAX_UPLOAD_BYTES=268435456
AUDIO_MAX_CONCURRENT=1
AUDIO_FFMPEG_THREADS=2
AUDIO_CONVERSION_TIMEOUT_SECONDS=1800
AUDIO_QUEUE_TIMEOUT_SECONDS=1
AUDIO_MAX_DURATION_SECONDS=3600
PORT=8000
